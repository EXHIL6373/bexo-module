{
  "name": "bexo-college-panel-backend",
  "version": "1.0.0",
  "description": "Production-grade multi-tenant backend for BEXO College Admin Control Panel",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false",
    "test:unit": "vitest run tests/security/stagingAndProductionHardening.test.ts --fileParallelism=false",
    "test:postgres": "vitest run tests/integration/postgresPersistenceAndCrud.test.ts tests/integration/postgresConcurrency.test.ts --fileParallelism=false",
    "test:integration": "vitest run tests/integration --fileParallelism=false",
    "test:release": "vitest run --fileParallelism=false",
    "test:security": "vitest run tests/security --pool=forks",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/scripts/comprehensiveDbCrudCheck.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.40.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.15",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.30.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
