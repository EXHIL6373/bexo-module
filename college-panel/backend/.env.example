# ==============================================================================
# BEXO College Panel Backend — Environment Configuration Template
# ==============================================================================

# Runtime Environment: 'development' | 'staging' | 'production' | 'test'
NODE_ENV=staging
PORT=8000
API_PREFIX=/api/v1

# Reverse Proxy Trust (1 for single reverse proxy like AWS ALB, Cloudflare, or Nginx)
TRUST_PROXY=1

# Allowed Frontend Origins (comma-separated for multiple domains)
FRONTEND_ORIGIN=https://staging-college.bexo.edu
ALLOW_LOCALHOST_CORS=false

# PostgreSQL Connection (Strict verify-full SSL mode enforced in staging & production)
DATABASE_URL=postgresql://<username>:<password>@<staging-host>:5432/<staging-database>?sslmode=verify-full
DB_SSL=true
DB_CONNECTION_TIMEOUT_MS=10000
USE_POSTGRES_STORE=true

# Authentication & Security
# Cryptographically secure random secret (>= 32 chars, e.g. via `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_random_staging_secret_min_32_characters_long
JWT_EXPIRES_IN=24h

# Email Notification Delivery: 'smtp' | 'mock' | 'console'
EMAIL_PROVIDER=smtp
EMAIL_FROM="BEXO Institutional Gateway" <no-reply@atbexo.com>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_here

# Rate Limiting & Protection
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# Logging & Telemetry: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=info

# Service-to-Service Integration (Central Admin <-> College Panel)
SERVICE_AUTH_SECRET=replace_with_shared_service_auth_secret_minimum_32_characters
INTERNAL_M2M_SECRET=replace_with_internal_m2m_service_key_2026
ADMIN_PANEL_API_URL=http://localhost:8080


