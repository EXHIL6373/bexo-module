# =========================================================================
# BEXO Admin Panel — Frontend Environment Configuration
# =========================================================================

# Backend API Base URL (BEXO Admin Panel Backend on Port 8080)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# In-Memory Simulation Flag
# Set to 'false' for production deployments.
# Set to 'true' only for local mock demonstration when backend is not running.
VITE_DEMO_MODE=false

# External College Portal URL
# Non-corporate college accounts attempting admin access will be directed here.
VITE_COLLEGE_PORTAL_URL=http://localhost:5174
