# ==============================================================================
# BEXO Admin Panel Backend — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the backend server.
# Staging and Production require USE_POSTGRES_STORE=true and a >=32 char JWT_SECRET.
# ==============================================================================

# Application Environment & Server
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
TRUST_PROXY=1

# Database Configuration (PostgreSQL 14+)
# When USE_POSTGRES_STORE=false, an in-memory repository is used for zero-dependency dev & testing.
# When USE_POSTGRES_STORE=true, Drizzle ORM connects to PostgreSQL via DATABASE_URL.
USE_POSTGRES_STORE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bexo_admin_db?sslmode=disable
DB_SSL=false
DB_CONNECTION_TIMEOUT_MS=10000

# Authentication & JWT Security
# In production, generate a secure 64-character random key: `openssl rand -hex 32`
JWT_SECRET=bexo-central-admin-super-secure-jwt-key-2026-staging-32-chars-minimum
JWT_EXPIRES_IN=24h

# Cross-Origin Resource Sharing (CORS) & Downstream URLs
# Comma-separated list of allowed origins
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
COLLEGE_PORTAL_URL=http://localhost:5174
COLLEGE_PANEL_API_URL=http://localhost:8000
MOBILE_APP_API_URL=http://localhost:3001
SERVICE_AUTH_SECRET=bexo-service-to-service-secret-key-2026-staging-32-chars
ALLOW_LOCALHOST_CORS=true

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Structured Logging (Pino)
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Outbound Email Service
# Providers: 'console' (logs to stdout in dev), 'mock' (in-memory outbox), 'smtp' (production mailer)
EMAIL_PROVIDER=console
EMAIL_FROM="BEXO Corporate Administration" <no-reply@atbexo.com>
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=smtp-user@atbexo.com
SMTP_PASSWORD=replace-with-actual-smtp-password
