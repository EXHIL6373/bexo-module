# Backend API Base URL (Point to deployed staging backend for staging builds)
# Local: http://localhost:8000/api/v1
# Staging: https://staging-college-api.bexo.edu/api/v1
VITE_API_BASE_URL=https://staging-college-api.bexo.edu/api/v1

# Demo Mode toggle: Keep false in staging and production to enforce real backend APIs
VITE_DEMO_MODE=false

